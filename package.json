{
  "name": "dashboard-hub",
  "version": "1.18.1",
  "description": "All my local web panels in one window",
  "main": "main.js",
  "author": "Me",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never && node tools/finish-build.js",
    "dist:linux": "electron-builder --linux AppImage --publish never && node tools/finish-build.js"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "local.dashboard.hub",
    "productName": "Dashboard Hub",
    "publish": null,
    "files": [
      "*.js",
      "*.html",
      "*.css",
      "package.json",
      "vendor/**/*",
      "!test/**",
      "!tools/**",
      "!node_modules/**",
      "!*.md",
      "!*.hubupdate"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "linux": {
      "target": "AppImage",
      "category": "Network",
      "executableName": "dashboard-hub"
    },
    "appImage": {
      "artifactName": "Dashboard-Hub.AppImage"
    },
    "directories": {
      "output": "Dashboard Hub"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dashboard Hub",
      "uninstallDisplayName": "Dashboard Hub",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Dashboard-Hub-Setup.exe",
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    }
  }
}
